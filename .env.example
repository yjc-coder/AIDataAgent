# LLM (OpenAI-compatible; works with Qwen / DeepSeek / OpenAI)
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=qwen-plus

# Embedding (used from Phase 5 onward)
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=your-api-key-here
EMBEDDING_MODEL=text-embedding-v3

# Server
APP_HOST=0.0.0.0
APP_PORT=8065
APP_DEBUG=false

# MySQL (Phase 2 — matches docker-compose.yml)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=readonly
DB_PASSWORD=readonly
DB_NAME=demo
DB_CHARSET=utf8mb4
DB_POOL_MIN=1
DB_POOL_MAX=10

# Phase 2+ placeholders (currently unused)
# CHROMA_DIR=./data/chroma

# Phase 5: RAG (Chroma) — leave defaults if you don't know what to set
CHROMA_DIR=./data/chroma
CHROMA_COLLECTION=ai_data_agent_knowledge
RAG_TOP_K=4
RAG_FORCE_REBUILD=false
RAG_CHUNK_SIZE=400
RAG_CHUNK_OVERLAP=60
